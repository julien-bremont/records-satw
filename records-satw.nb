Cell["Simple expressions for \[Alpha]=2k+1", "Section",
 CellChangeTimes->{{3.984020948515827*^9, 
  3.98402095576486*^9}},ExpressionUUID->"4506d0e1-faa3-c746-9567-\
b81140453b56"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalXi]", "[", 
    RowBox[{"\[Alpha]_", ",", "u_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"Pochhammer", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"1", "-", "\[Alpha]"}], "2"], ",", "n"}], "]"}], 
       RowBox[{"Pochhammer", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"1", "+", "\[Alpha]"}], "2"], ",", "n"}], "]"}]], 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], 
        FractionBox[
         SuperscriptBox["n", "2"], "u"]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", "[", 
    RowBox[{"\[Alpha]_", ",", "\[Beta]_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"\[Beta]", 
    SqrtBox[
     FractionBox["2", 
      RowBox[{"\[Pi]", " ", "x"}]]], 
    FractionBox["1", 
     RowBox[{"Beta", "[", 
      RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}]], 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox["u", 
        RowBox[{"\[Alpha]", "-", "1"}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", "u"}], ")"}], 
        RowBox[{"\[Beta]", "-", "1"}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", 
          RowBox[{"\[CapitalXi]", "[", 
           RowBox[{"\[Alpha]", ",", 
            RowBox[{"x", " ", 
             SuperscriptBox["u", "2"]}]}], "]"}]}], "-", "1"}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"u", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9840209607791634`*^9, 3.9840210384493217`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"8c7b4397-9b2b-0942-a1ef-2b6546d77ddb"],

