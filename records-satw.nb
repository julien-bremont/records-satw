Cell["Numerical plot for \[Alpha],\[Beta]", "Section",
 CellChangeTimes->{{3.9358361374666786`*^9, 3.9358361417652664`*^9}, {
  3.9798111471459465`*^9, 
  3.9798111490637646`*^9}},ExpressionUUID->"e9fe9cc6-eecf-4a8b-a8ae-\
