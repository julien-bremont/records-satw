Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Alpha]", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Beta]", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"i", "[", 
    RowBox[{
     RowBox[{"n_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Tau]_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       SuperscriptBox["x", 
        RowBox[{"\[Beta]", "-", "1"}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", "x"}], ")"}], 
        RowBox[{"\[Alpha]", "+", "\[Beta]"}]]], 
      SuperscriptBox["E", 
       RowBox[{
        RowBox[{"-", "2"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"n", "+", "1"}], ")"}], "2"], 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", "x"}], ")"}], "2"], "\[Tau]"]}]]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
     RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"\[Tau]_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"2", 
      RowBox[{"(", 
       RowBox[{"\[Alpha]", "-", "1"}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Alpha]", "+", "1"}], ")"}], 
      RowBox[{"Beta", "[", 
       RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}]}]], 
    RowBox[{"NSum", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"Pochhammer", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"3", "-", "\[Alpha]"}], "2"], ",", "n"}], "]"}], 
        RowBox[{"Pochhammer", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"3", "+", "\[Alpha]"}], "2"], ",", "n"}], "]"}]], 
       RowBox[{"i", "[", 
        RowBox[{"n", ",", "\[Tau]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", 
        RowBox[{"IntegerPart", "[", 
         SqrtBox["\[Tau]"], "]"}]}], "}"}], ",", 
      RowBox[{"Method", "->", "\"\<WynnEpsilon\>\""}]}], "]"}]}]}], 
  ";"}]}], "Input",
