Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"weightsat", "[", 
    RowBox[{"n_", ",", "\[Phi]_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", "\[Phi]"], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox["1", "\[Phi]"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["2", 
        RowBox[{"1", "+", 
         SuperscriptBox["E", 
          RowBox[{"-", "n"}]]}]], "-", "1"}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
