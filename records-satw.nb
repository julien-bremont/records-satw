Cell["Numerical tests of integral equalities", "Section",
 CellChangeTimes->{{3.9360832774042783`*^9, 
  3.936083282144617*^9}},ExpressionUUID->"4c8f2c3e-9c18-4902-a334-\
390fea3d0f12"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Phi]", "=", 
   FractionBox["3", "4"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Mu]", "=", "0.000000000001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"k", "=", "1"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        SuperscriptBox["m", 
         RowBox[{"\[Phi]", "-", "1"}]], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "m"}], ")"}], 
         RowBox[{"2", "\[Phi]"}]]], 
       RowBox[{"Coth", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", "m"}], ")"}], "\[Mu]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"\[Mu]", " ", "\[Phi]", " ", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         FractionBox[
          SuperscriptBox["m1", 
           RowBox[{"\[Phi]", "-", "1"}]], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", "m1"}], ")"}], 
           RowBox[{"2", "\[Phi]"}]]], 
         FractionBox[
          SuperscriptBox[
           RowBox[{"Sinh", "[", 
            RowBox[{"\[Mu]", 
             RowBox[{"(", 
              RowBox[{"1", "+", "m1"}], ")"}]}], "]"}], 
           RowBox[{"\[Phi]", "-", "1"}]], 
          SuperscriptBox[
           RowBox[{"Sinh", "[", 
            RowBox[{"\[Mu]", 
             RowBox[{"(", 
              RowBox[{"1", "+", "m2"}], ")"}]}], "]"}], 
           RowBox[{"\[Phi]", "+", "1"}]]]}], ",", 
        RowBox[{"{", 
         RowBox[{"m1", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m2", ",", "m1", ",", "\[Infinity]"}], "}"}], ",", 
        RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}]}], "]"}]}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"2", 
     FractionBox["\[Phi]", 
      RowBox[{"1", "+", "\[Phi]"}]], " ", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        FractionBox[
         SuperscriptBox["m", 
          RowBox[{"\[Phi]", "-", "1"}]], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", "m"}], ")"}], 
          RowBox[{"2", "\[Phi]"}]]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Coth", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "m"}], ")"}], "\[Mu]"}], "]"}], "-", "1"}], 
         ")"}], 
        RowBox[{"Hypergeometric2F1", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"1", "-", "\[Phi]"}], "2"], ",", "1", ",", 
          FractionBox[
           RowBox[{"3", "+", "\[Phi]"}], "2"], ",", 
          SuperscriptBox["E", 
           RowBox[{
            RowBox[{"-", "2"}], 
            RowBox[{"(", 
             RowBox[{"1", "+", "m"}], ")"}], "\[Mu]"}]]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"m", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
       RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"%", "/", "%%"}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   FractionBox["\[Mu]", 
    RowBox[{"Beta", "[", 
     RowBox[{"\[Phi]", ",", "\[Phi]"}], "]"}]], " ", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       FractionBox[
        SuperscriptBox["m", 
